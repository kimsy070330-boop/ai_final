#include "raylib.h"

void render_game(int board[][15], int size, int x, int y,
                 int row_hints[][8], int row_hint_counts[],
                 int col_hints[][8], int col_hint_counts[]) {
    int i, j, k;
    int cell = 45;
    int start_x = 180;
    int start_y = 180;

    // 1. 상단 열 힌트 그리기
    for (j = 0; j < size; j++) {
        int count = col_hint_counts[j];
        for (k = 0; k < count; k++) {
            int val = col_hints[j][k];
            int px = start_x + j * cell + 14;
            int py = start_y - (count - k) * 26 - 6;
            DrawText(TextFormat("%d", val), px, py, 20, (j == x) ? ORANGE : DARKBLUE);
        }
    }

    // 2. 좌측 행 힌트 그리기
    for (i = 0; i < size; i++) {
        int count = row_hint_counts[i];
        for (k = 0; k < count; k++) {
            int val = row_hints[i][k];
            int px = start_x - (count - k) * 28 - 8;
            int py = start_y + i * cell + 12;
            DrawText(TextFormat("%d", val), px, py, 20, (i == y) ? ORANGE : DARKBLUE);
        }
    }

    // 3. 메인 격자판 타일 그리기
    for (i = 0; i < size; i++) {
        for (j = 0; j < size; j++) {
            int px = start_x + j * cell;
            int py = start_y + i * cell;

            DrawRectangle(px + 2, py + 2, cell - 4, cell - 4, WHITE);

            if (board[i][j] == 1) {
                DrawRectangleRounded((Rectangle){(float)px + 4, (float)py + 4, (float)cell - 8, (float)cell - 8}, 0.2f, 6, DARKBLUE);
            } else if (board[i][j] == 2) {
                DrawLineEx((Vector2){(float)px + 12, (float)py + 12}, (Vector2){(float)px + cell - 12, (float)py + cell - 12}, 3.0f, RED);
                DrawLineEx((Vector2){(float)px + cell - 12, (float)py + 12}, (Vector2){(float)px + 12, (float)py + cell - 12}, 3.0f, RED);
            }

            if (i == y && j == x) {
                DrawRectangleLinesEx((Rectangle){(float)px, (float)py, (float)cell, (float)cell}, 3.0f, ORANGE);
            } else {
                DrawRectangleLines(px, py, cell, cell, LIGHTGRAY);
            }
        }
    }
}

int main(void) {
    int board[15][15] = {0};
    int row_hints[15][8] = {{1, 1, 1}, {2}, {1, 2}, {0}, {5}};
    int row_counts[15] = {3, 1, 2, 1, 1};
    int col_hints[15][8] = {{1, 1}, {2, 1}, {1}, {1, 1}, {3}};
    int col_counts[15] = {2, 2, 1, 2, 1};

    board[1][2] = 1; // 채움 타일 샘플
    board[2][1] = 2; // X 표시 타일 샘플

    InitWindow(520, 500, "Test 4: render_game (App UI)");
    SetTargetFPS(60);

    while (!WindowShouldClose()) {
        BeginDrawing();
        ClearBackground((Color){245, 247, 250, 255});
        DrawText("NONOGRAM APP UI RENDER TEST", 95, 25, 20, DARKBLUE);
        render_game(board, 5, 0, 0, row_hints, row_counts, col_hints, col_counts);
        EndDrawing();
    }
    CloseWindow();
    return 0;
}
